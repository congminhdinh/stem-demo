long x = 0L;
long y = 0L;

void pwmWrite(uint8_t pin, long value) {
  if (value < 0L) value = 0L;
  if (value > 255L) value = 255L;
  analogWrite(pin, (int)value);
}

void setup() {
  Serial.begin(9600);
  pinMode(3, INPUT_PULLUP);
  pinMode(A1, INPUT);
  pinMode(A3, OUTPUT);
  digitalWrite(A3, (true) ? HIGH : LOW);
  digitalWrite(A3, (false) ? HIGH : LOW);
  pwmWrite(A4, 200L);
  x = 300L;
  pwmWrite(A4, x);
  Serial.println((digitalRead(3) == HIGH));
  Serial.println((digitalRead(A1) == HIGH));
  Serial.println((long)analogRead(A0));
}

