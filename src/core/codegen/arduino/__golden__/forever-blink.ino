#define LED1_PIN 13

void setup() {
  Serial.begin(9600);
  pinMode(LED1_PIN, OUTPUT);
  Serial.println(F("start"));
}

void loop() {
  digitalWrite(LED1_PIN, (true) ? HIGH : LOW);
  delay(500L);
  digitalWrite(LED1_PIN, (false) ? HIGH : LOW);
  delay(500L);
}
