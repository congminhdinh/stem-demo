{
  "schemaVersion": 1,
  "id": "sample-button-direct",
  "name": "Button without a program",
  "circuit": {
    "components": [
      { "id": "board", "deviceType": "board", "position": { "x": 240, "y": 300 } },
      { "id": "button", "deviceType": "push-button", "position": { "x": 140, "y": 80 } },
      { "id": "resistor", "deviceType": "resistor", "position": { "x": 280, "y": 80 } },
      { "id": "led", "deviceType": "led", "position": { "x": 420, "y": 80 } }
    ],
    "wires": [
      {
        "id": "wire-3v3-button",
        "from": { "componentId": "board", "portId": "3v3" },
        "to": { "componentId": "button", "portId": "a" }
      },
      {
        "id": "wire-button-resistor",
        "from": { "componentId": "button", "portId": "b" },
        "to": { "componentId": "resistor", "portId": "a" }
      },
      {
        "id": "wire-resistor-anode",
        "from": { "componentId": "resistor", "portId": "b" },
        "to": { "componentId": "led", "portId": "anode" }
      },
      {
        "id": "wire-cathode-gnd",
        "from": { "componentId": "led", "portId": "cathode" },
        "to": { "componentId": "board", "portId": "gnd" }
      }
    ]
  },
  "program": {
    "blocks": {
      "blocks": {
        "languageVersion": 0,
        "blocks": [
          { "type": "stem_on_start", "id": "on-start", "x": 40, "y": 40 },
          { "type": "stem_forever", "id": "forever", "x": 40, "y": 220 }
        ]
      }
    }
  }
}
