{
  "name": "stem-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:python": "node scripts/check-python-syntax.mjs --require",
    "check:micropython": "node scripts/check-python-syntax.mjs --require-mpy",
    "check:arduino": "node scripts/check-arduino.mjs src tests",
    "export:robot-manifest": "node scripts/export-robot-manifest.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic": "0.21.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "blockly": "13.3.0",
    "dexie": "4.4.6",
    "konva": "10.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "avr8js": "0.21.1",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
